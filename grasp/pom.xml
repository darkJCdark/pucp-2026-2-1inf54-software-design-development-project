<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.edu.pucp</groupId>
        <artifactId>paqrap-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paqrap-grasp</artifactId>
    <packaging>jar</packaging>

    <name>PaqRap - Algoritmo GRASP</name>
    <description>
        Algoritmo GRASP (Greedy Randomized Adaptive Search Procedure) para
        el componente planificador de PaqRap -- 1INF54, Grupo 4D. Opera
        sobre el modelo de dominio compartido (paqrap-dominio), no tiene
        modelo propio.
    </description>

    <properties>
        <exec.mainClass>pe.pucp.paqrap.app.DemoPlanificacion</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>pe.edu.pucp</groupId>
            <artifactId>paqrap-dominio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
