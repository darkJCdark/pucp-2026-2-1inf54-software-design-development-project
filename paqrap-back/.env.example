# PaqRap - entorno local de desarrollo con Docker
# Copiar como .env y cambiar las contraseñas si se desea.

PAQRAP_DB_PORT=3307
PAQRAP_DB_NAME=paqrap
PAQRAP_DB_USER=paqrap
PAQRAP_DB_PASSWORD=paqrap_dev
PAQRAP_DB_ROOT_PASSWORD=paqrap_root_dev

# Variables que Spring Boot puede consumir directamente.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/paqrap?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=paqrap
SPRING_DATASOURCE_PASSWORD=paqrap_dev
